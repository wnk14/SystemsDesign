1. Largest Digit in a Number
#include <iostream>
#include <cstdlib>   // for abs()
using namespace std;

int largestDigit(int n) {
    n = abs(n);          // handle negative numbers
    int largest = 0;
    if (n == 0) return 0;
    while (n > 0) {
        int digit = n % 10;
        if (digit > largest)
            largest = digit;
        n /= 10;
    }
    return largest;
}

int main() {
    int num;
    cout << "Enter a number: ";
    cin >> num;

    cout << "Largest digit: " << largestDigit(num) << endl;
    return 0;
}

2. Count Even Digits in a Number
#include <iostream>
#include <cstdlib>   // for abs()
using namespace std;

int countEvenDigits(int n) {
    n = abs(n);          // handle negative numbers
    int count = 0;

    if (n == 0) return 1;  // 0 is even

    while (n > 0) {
        int digit = n % 10;
        if (digit % 2 == 0)
            count++;
        n /= 10;
    }
    return count;
}

int main() {
    int num;
    cout << "Enter a number: ";
    cin >> num;

    cout << "Number of even digits: " << countEvenDigits(num) << endl;
    return 0;
}

3. Reverse a Number
#include <iostream>
#include <cstdlib>   // for abs()
using namespace std;

int reverseNumber(int n) {
    int sign = (n < 0) ? -1 : 1;
    n = abs(n);

    int reversed = 0;
    while (n > 0) {
        reversed = reversed * 10 + (n % 10);
        n /= 10;
    }
    return sign * reversed;
}

int main() {
    int num;
    cout << "Enter a number: ";
    cin >> num;

    cout << "Reversed number: " << reverseNumber(num) << endl;
    return 0;
}