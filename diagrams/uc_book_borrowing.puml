@startuml
left to right direction
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFF2CC
  BorderColor #B8860B
}
skinparam rectangle {
  BackgroundColor #FFFFFF
}

actor "Borrower\n(ACT-01)" as B
actor "Librarian\n(ACT-02)" as L
actor "University SSO\n(ACT-03)" as SSO
actor "Payment Gateway\n(ACT-04)" as PG

rectangle "Book Borrowing (core function)" {
  usecase "UC-01\nSearch Book" as UC1
  usecase "UC-02\nReserve Book" as UC2
  usecase "UC-03\nCheck Out Book" as UC3
  usecase "UC-04\nRenew Loan" as UC4
  usecase "UC-05\nReturn Book" as UC5
  usecase "UC-06\nVerify Borrower\nEligibility" as UC6
  usecase "UC-07\nSettle Late Fine" as UC7
}

B -- UC1
B -- UC2
B -- UC3
B -- UC4
B -- UC5
L -- UC3
L -- UC5

UC2 ..> UC6 : <<include>>
UC3 ..> UC6 : <<include>>
UC4 ..> UC6 : <<include>>
UC7 ..> UC5 : <<extend>>

UC6 -- SSO
UC7 -- PG
@enduml
